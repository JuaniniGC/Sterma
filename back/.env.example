# ------------------------------------------------------------------
# Plantilla de variables de entorno del backend
# ------------------------------------------------------------------
# application.properties no contiene valores: todo se lee de estas
# variables. En Railway se definen en la pestaña "Variables" del
# servicio; en local copia este archivo como `.env` (está en
# .gitignore) y úsalo con `docker compose up`.
# ------------------------------------------------------------------

# PostgreSQL. En Railway usa variables de referencia al servicio
# de base de datos, p. ej. PGHOST=${{Postgres.PGHOST}}
PGHOST=localhost
PGPORT=5432
PGDATABASE=sterma
PGUSER=sterma
PGPASSWORD=cambia-esta-contraseña

# JWT. El secreto debe tener al menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Orígenes que pueden llamar a la API desde el navegador, separados
# por comas y sin barra final. En Railway:
#   CORS_ALLOWED_ORIGINS=https://${{admin.RAILWAY_PUBLIC_DOMAIN}}
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Swagger UI (/swagger-ui.html). Déjalo en false en producción.
SWAGGER_ENABLED=true

# Puerto HTTP. Railway lo asigna automáticamente: no lo definas allí.
# PORT=8080
